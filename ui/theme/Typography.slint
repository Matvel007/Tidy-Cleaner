export global Typography {
    out property <string> font_family: "Inter, Ubuntu, Cantarell, sans-serif";
    out property <string> font_mono: "JetBrains Mono, Fira Code, monospace";

    out property <length> size_xs: 11px;
    out property <length> size_sm: 12px;
    out property <length> size_base: 13px;
    out property <length> size_md: 14px;
    out property <length> size_lg: 16px;
    out property <length> size_xl: 20px;
    out property <length> size_2xl: 24px;
    out property <length> size_3xl: 30px;

    out property <int> weight_normal: 400;
    out property <int> weight_medium: 500;
    out property <int> weight_semibold: 600;
    out property <int> weight_bold: 700;
}
