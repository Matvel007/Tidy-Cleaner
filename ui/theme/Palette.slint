export global Theme {
    in-out property <bool> is_dark: true;

    // Backgrounds - Premium deep slate in dark, soft elegant grey-slate in light
    out property <color> background: is_dark ? #121317 : #edf0f5;
    out property <color> surface: is_dark ? #1a1c23 : #ffffff;
    out property <color> surface_secondary: is_dark ? #222530 : #e5eaf2;
    out property <color> surface_hover: is_dark ? #2a2e3c : #dde4ee;
    out property <color> surface_active: is_dark ? #34394a : #ced8e6;

    // Borders - Crisply defined and slightly darker in light theme
    out property <color> border: is_dark ? #282c38 : #c6d0dc;
    out property <color> border_subtle: is_dark ? #1e212b : #d8e0ea;
    out property <color> border_focus: is_dark ? #6366f1 : #4f46e5;

    // Text colors
    out property <color> text_primary: is_dark ? #f1f5f9 : #0f172a;
    out property <color> text_secondary: is_dark ? #94a3b8 : #475569;
    out property <color> text_muted: is_dark ? #64748b : #64748b;
    out property <color> text_inverse: is_dark ? #0f172a : #ffffff;

    // Button & Component Accents - Refined graphite / steel slate (not screaming blue)
    out property <color> button_primary_bg: is_dark ? #2e3444 : #1e293b;
    out property <color> button_primary_hover: is_dark ? #3a4256 : #334155;
    out property <color> button_primary_active: is_dark ? #454f66 : #0f172a;
    out property <color> button_primary_border: is_dark ? #414a60 : #334155;
    out property <color> button_primary_text: #ffffff;

    out property <color> accent: is_dark ? #6366f1 : #4f46e5;
    out property <color> accent_light: is_dark ? #252838 : #e0e7ff;
    out property <color> accent_hover: is_dark ? #818cf8 : #4338ca;
    out property <color> accent_text: #ffffff;

    // Status colors
    out property <color> success: is_dark ? #10b981 : #059669;
    out property <color> success_bg: is_dark ? #064e3b : #d1fae5;
    out property <color> warning: is_dark ? #f59e0b : #d97706;
    out property <color> warning_bg: is_dark ? #78350f : #fef3c7;
    out property <color> danger: is_dark ? #ef4444 : #dc2626;
    out property <color> danger_bg: is_dark ? #40191f : #fee2e2;
    out property <color> danger_hover: is_dark ? #522028 : #fecaca;
    out property <color> danger_border: is_dark ? #632630 : #fca5a5;
    out property <color> danger_text: is_dark ? #fca5a5 : #b91c1c;

    // Metrics / Charts
    out property <color> cpu_chart: is_dark ? #38bdf8 : #0284c7;
    out property <color> ram_chart: is_dark ? #a855f7 : #7c3aed;
    out property <color> disk_chart: is_dark ? #10b981 : #059669;

    // Radius constants
    out property <length> radius_sm: 4px;
    out property <length> radius_md: 8px;
    out property <length> radius_lg: 12px;
    out property <length> radius_xl: 16px;
    out property <length> radius_full: 9999px;
}
