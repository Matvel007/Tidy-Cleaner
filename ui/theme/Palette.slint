export global Theme {
    in-out property <bool> is_dark: true;

    // Backgrounds
    out property <color> background: is_dark ? #111216 : #f8fafc;
    out property <color> surface: is_dark ? #181a20 : #ffffff;
    out property <color> surface_secondary: is_dark ? #21242c : #f1f5f9;
    out property <color> surface_hover: is_dark ? #282c37 : #e2e8f0;
    out property <color> surface_active: is_dark ? #323846 : #cbd5e1;

    // Borders
    out property <color> border: is_dark ? #272a34 : #e2e8f0;
    out property <color> border_subtle: is_dark ? #1e2129 : #f1f5f9;
    out property <color> border_focus: is_dark ? #3b82f6 : #2563eb;

    // Text colors
    out property <color> text_primary: is_dark ? #f1f5f9 : #0f172a;
    out property <color> text_secondary: is_dark ? #94a3b8 : #64748b;
    out property <color> text_muted: is_dark ? #64748b : #94a3b8;
    out property <color> text_inverse: is_dark ? #0f172a : #ffffff;

    // Accent colors (Refined blue / indigo)
    out property <color> accent: is_dark ? #3b82f6 : #2563eb;
    out property <color> accent_hover: is_dark ? #60a5fa : #1d4ed8;
    out property <color> accent_light: is_dark ? #1e293b : #dbeafe;
    out property <color> accent_text: #ffffff;

    // Status colors
    out property <color> success: is_dark ? #10b981 : #059669;
    out property <color> success_bg: is_dark ? #064e3b : #d1fae5;
    out property <color> warning: is_dark ? #f59e0b : #d97706;
    out property <color> warning_bg: is_dark ? #78350f : #fef3c7;
    out property <color> danger: is_dark ? #ef4444 : #dc2626;
    out property <color> danger_bg: is_dark ? #7f1d1d : #fee2e2;

    // Metrics / Charts
    out property <color> cpu_chart: is_dark ? #38bdf8 : #0284c7;
    out property <color> ram_chart: is_dark ? #a855f7 : #7c3aed;
    out property <color> disk_chart: is_dark ? #10b981 : #059669;

    // Radius constants
    out property <length> radius_sm: 4px;
    out property <length> radius_md: 8px;
    out property <length> radius_lg: 12px;
    out property <length> radius_xl: 16px;
    out property <length> radius_full: 9999px;
}
