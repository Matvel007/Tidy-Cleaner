import { Theme } from "../theme/Palette.slint";
import { Typography } from "../theme/Typography.slint";
import { I18n } from "../I18n.slint";
import { Card } from "../components/Card.slint";
import { CircularGauge } from "../components/CircularGauge.slint";
import { TemperatureCard } from "../components/TemperatureCard.slint";
import { DiskCard } from "../components/DiskCard.slint";

export component DashboardPage inherits VerticalLayout {
    // CPU Metrics
    in property <string> cpu_usage_str: "0.0";
    in property <string> cpu_cores_str: "0";
    in property <string> cpu_freq_str: "0 MHz";
    in property <string> cpu_brand: "CPU";
    in property <string> cpu_arc_path: "";

    // GPU Metrics
    in property <string> gpu_usage_str: "0.0";
    in property <string> gpu_name: "GPU";
    in property <string> gpu_vram_str: "0 MB";
    in property <string> gpu_arc_path: "";

    // RAM Metrics
    in property <string> ram_usage_str: "0.0";
    in property <string> ram_used_str: "0 GB";
    in property <string> ram_available_str: "0 GB";
    in property <string> ram_total_str: "0 GB";
    in property <string> ram_arc_path: "";

    // Temperature Metrics
    in property <string> cpu_temp_str: "0";
    in property <float> cpu_temp_val: 0.0;
    in property <string> gpu_temp_str: "0";
    in property <float> gpu_temp_val: 0.0;

    // Primary Disk (Disk 1)
    in property <string> disk1_name: I18n.dashboard_storage_primary;
    in property <string> disk1_fs: "btrfs";
    in property <string> disk1_used_str: "0 GB";
    in property <string> disk1_total_str: "0 GB";
    in property <string> disk1_free_str: "0 GB";
    in property <float> disk1_usage_ratio: 0.0;
    in property <string> disk1_percent_str: "0%";

    // Secondary Disk (Disk 2)
    in property <bool> has_disk2: false;
    in property <string> disk2_name: I18n.dashboard_storage_secondary;
    in property <string> disk2_fs: "btrfs";
    in property <string> disk2_used_str: "0 GB";
    in property <string> disk2_total_str: "0 GB";
    in property <string> disk2_free_str: "0 GB";
    in property <float> disk2_usage_ratio: 0.0;
    in property <string> disk2_percent_str: "0%";

    // System Overview
    in property <string> os_name: "Linux";
    in property <string> kernel_version: "Unknown";
    in property <string> hostname: "localhost";
    in property <string> uptime_str: "0s";

    padding: 12px;
    spacing: 10px;

    HorizontalLayout {
        spacing: 10px;
        vertical-stretch: 1;

        // LEFT SECTION: 3 Wide Circular Gauges (Top) and Full Storage Card (Bottom)
        VerticalLayout {
            horizontal-stretch: 2.8;
            spacing: 10px;

            // TOP ROW: 3 Circular Gauges
            HorizontalLayout {
                spacing: 10px;
                height: 200px;

                // 1. CPU Gauge
                CircularGauge {
                    horizontal-stretch: 1;
                    title: "CPU";
                    value_str: root.cpu_usage_str;
                    subtext_top: root.cpu_freq_str;
                    subtext_bottom: root.cpu_brand + " • " + root.cpu_cores_str + " " + I18n.dashboard_cores_label;
                    ring_color: Theme.cpu_chart;
                    arc_path: root.cpu_arc_path;
                }

                // 2. GPU Gauge
                CircularGauge {
                    horizontal-stretch: 1;
                    title: "GPU";
                    value_str: root.gpu_usage_str;
                    subtext_top: root.gpu_vram_str;
                    subtext_bottom: root.gpu_name;
                    ring_color: #10b981;
                    arc_path: root.gpu_arc_path;
                }

                // 3. RAM Gauge
                CircularGauge {
                    horizontal-stretch: 1;
                    title: "RAM";
                    value_str: root.ram_usage_str;
                    subtext_top: root.ram_used_str + " / " + root.ram_total_str;
                    subtext_bottom: I18n.common_free + ": " + root.ram_available_str;
                    ring_color: Theme.ram_chart;
                    arc_path: root.ram_arc_path;
                }
            }

            // BOTTOM ROW: Separate Disk Cards
            HorizontalLayout {
                spacing: 10px;
                vertical-stretch: 1;
                min-height: 160px;

                DiskCard {
                    vertical-stretch: 1;
                    disk_name: root.disk1_name != "" ? root.disk1_name : I18n.dashboard_storage_primary;
                    file_system: root.disk1_fs;
                    used_str: root.disk1_used_str;
                    total_str: root.disk1_total_str;
                    free_str: root.disk1_free_str;
                    usage_ratio: root.disk1_usage_ratio;
                    percent_str: root.disk1_percent_str;
                }

                if root.has_disk2: DiskCard {
                    vertical-stretch: 1;
                    disk_name: root.disk2_name != "" ? root.disk2_name : I18n.dashboard_storage_secondary;
                    file_system: root.disk2_fs;
                    used_str: root.disk2_used_str;
                    total_str: root.disk2_total_str;
                    free_str: root.disk2_free_str;
                    usage_ratio: root.disk2_usage_ratio;
                    percent_str: root.disk2_percent_str;
                }
            }
        }

        // RIGHT SECTION: Temperature (Top) and System Overview (Bottom)
        VerticalLayout {
            horizontal-stretch: 1.55;
            spacing: 10px;

            // Top: Temperature Card
            TemperatureCard {
                height: 200px;
                cpu_temp_str: root.cpu_temp_str;
                cpu_temp_val: root.cpu_temp_val;
                gpu_temp_str: root.gpu_temp_str;
                gpu_temp_val: root.gpu_temp_val;
            }

            // Bottom: System Overview Card
            Card {
                vertical-stretch: 1;
                min-height: 160px;
                padding_horizontal: 16px;
                padding_vertical: 12px;

                VerticalLayout {
                    spacing: 10px;
                    alignment: space-between;

                    // Header Title
                    HorizontalLayout {
                        height: 18px;
                        alignment: space-between;
                        Text {
                            text: I18n.dashboard_system_overview;
                            font-family: Typography.font_family;
                            font-size: Typography.size_xs;
                            font-weight: Typography.weight_bold;
                            color: Theme.text_secondary;
                            vertical-alignment: center;
                        }
                    }

                    // Line 1: OS
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "❯"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.accent; }
                        Text { text: "OS:"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.text_secondary; width: 60px; }
                        Text { text: root.os_name; font-family: Typography.font_family; font-size: Typography.size_xs; color: Theme.text_primary; overflow: elide; }
                    }

                    // Line 2: Host
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "❯"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.accent; }
                        Text { text: "Host:"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.text_secondary; width: 60px; }
                        Text { text: root.hostname; font-family: Typography.font_mono; font-size: Typography.size_xs; color: Theme.text_primary; overflow: elide; }
                    }

                    // Line 3: Kernel
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "❯"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.accent; }
                        Text { text: "Kernel:"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.text_secondary; width: 60px; }
                        Text { text: root.kernel_version; font-family: Typography.font_mono; font-size: Typography.size_xs; color: Theme.text_primary; overflow: elide; }
                    }

                    // Line 4: Uptime
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text { text: "❯"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.accent; }
                        Text { text: "Uptime:"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.text_secondary; width: 60px; }
                        Text { text: root.uptime_str; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_semibold; color: Theme.accent; }
                    }
                }
            }
        }
    }
}
