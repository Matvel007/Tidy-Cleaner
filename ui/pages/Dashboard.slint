import { Theme } from "../theme/Palette.slint";
import { Typography } from "../theme/Typography.slint";
import { I18n } from "../I18n.slint";
import { Card } from "../components/Card.slint";
import { CircularGauge } from "../components/CircularGauge.slint";
import { IconDisk } from "../components/Icons.slint";

export component DashboardPage inherits VerticalLayout {
    // CPU Metrics
    in property <string> cpu_usage_str: "0.0";
    in property <string> cpu_cores_str: "0";
    in property <string> cpu_freq_str: "0 MHz";
    in property <string> cpu_brand: "CPU";
    in property <string> cpu_arc_path: "";

    // GPU Metrics
    in property <string> gpu_usage_str: "0.0";
    in property <string> gpu_name: "GPU";
    in property <string> gpu_vram_str: "0 MB";
    in property <string> gpu_arc_path: "";

    // RAM Metrics
    in property <string> ram_usage_str: "0.0";
    in property <string> ram_used_str: "0 GB";
    in property <string> ram_available_str: "0 GB";
    in property <string> ram_total_str: "0 GB";
    in property <string> ram_arc_path: "";

    // Storage (Primary Drive)
    in property <string> disk_name: "Встроенный накопитель";
    in property <string> disk_fs: "btrfs";
    in property <string> disk_used_str: "0 GB";
    in property <string> disk_total_str: "0 GB";
    in property <string> disk_free_str: "0 GB";
    in property <float> disk_usage_ratio: 0.0;
    in property <string> disk_percent_str: "0%";

    // System Overview
    in property <string> os_name: "Linux";
    in property <string> kernel_version: "Unknown";
    in property <string> hostname: "localhost";
    in property <string> uptime_str: "0s";

    padding: 16px;
    spacing: 14px;
    alignment: start;

    // TOP ROW: 3 Circular Gauges (CPU, GPU, RAM)
    HorizontalLayout {
        spacing: 12px;
        height: 204px;

        // 1. CPU Gauge
        CircularGauge {
            horizontal-stretch: 1;
            title: "CPU";
            value_str: root.cpu_usage_str;
            subtext_top: root.cpu_freq_str;
            subtext_bottom: root.cpu_brand + " • " + root.cpu_cores_str + " Cores";
            ring_color: Theme.cpu_chart;
            arc_path: root.cpu_arc_path;
        }

        // 2. GPU Gauge
        CircularGauge {
            horizontal-stretch: 1;
            title: "GPU";
            value_str: root.gpu_usage_str;
            subtext_top: root.gpu_vram_str;
            subtext_bottom: root.gpu_name;
            ring_color: #10b981;
            arc_path: root.gpu_arc_path;
        }

        // 3. RAM Gauge
        CircularGauge {
            horizontal-stretch: 1;
            title: "RAM";
            value_str: root.ram_usage_str;
            subtext_top: root.ram_used_str + " / " + root.ram_total_str;
            subtext_bottom: "Free: " + root.ram_available_str;
            ring_color: Theme.ram_chart;
            arc_path: root.ram_arc_path;
        }
    }

    // BOTTOM ROW: Storage (Left) & Compact System Info (Right)
    HorizontalLayout {
        spacing: 12px;
        height: 170px;

        // Storage Card (Primary Drive)
        Card {
            horizontal-stretch: 1;
            padding_horizontal: 18px;
            padding_vertical: 14px;

            VerticalLayout {
                spacing: 12px;
                alignment: space-between;

                // Header
                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        IconDisk {
                            y: (parent.height - self.height) / 2;
                            icon_size: 16px;
                        }

                        Text {
                            text: root.disk_name;
                            font-family: Typography.font_family;
                            font-size: Typography.size_base;
                            font-weight: Typography.weight_semibold;
                            color: Theme.text_primary;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.disk_percent_str;
                        font-family: Typography.font_mono;
                        font-size: Typography.size_sm;
                        font-weight: Typography.weight_bold;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }
                }

                // Progress Bar
                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.surface_secondary;
                    clip: true;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width * Math.min(1.0, Math.max(0.0, root.disk_usage_ratio));
                        height: 100%;
                        border-radius: 4px;
                        background: root.disk_usage_ratio > 0.9 ? Theme.danger :
                            root.disk_usage_ratio > 0.75 ? Theme.warning : Theme.disk_chart;

                        animate width { duration: 250ms; easing: ease-out; }
                    }
                }

                // Details Grid
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Занято"; font-size: Typography.size_xs; color: Theme.text_muted; }
                        Text { text: root.disk_used_str; font-size: Typography.size_xs; font-weight: Typography.weight_medium; color: Theme.text_primary; }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Свободно"; font-size: Typography.size_xs; color: Theme.text_muted; }
                        Text { text: root.disk_free_str; font-size: Typography.size_xs; font-weight: Typography.weight_medium; color: Theme.text_primary; }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Всего"; font-size: Typography.size_xs; color: Theme.text_muted; }
                        Text { text: root.disk_total_str; font-size: Typography.size_xs; font-weight: Typography.weight_medium; color: Theme.text_primary; }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        Text { text: "Файловая система"; font-size: Typography.size_xs; color: Theme.text_muted; }
                        Text { text: root.disk_fs; font-size: Typography.size_xs; font-weight: Typography.weight_medium; color: Theme.text_secondary; }
                    }
                }
            }
        }

        // Compact Terminal-Style System Info Card (Disk line removed)
        Card {
            horizontal-stretch: 1;
            padding_horizontal: 18px;
            padding_vertical: 14px;

            VerticalLayout {
                spacing: 6px;
                alignment: space-between;

                // Line 1: OS
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "❯"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.accent; }
                    Text { text: "OS:"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.text_secondary; width: 60px; }
                    Text { text: root.os_name; font-family: Typography.font_family; font-size: Typography.size_xs; color: Theme.text_primary; overflow: elide; }
                }

                // Line 2: Host
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "❯"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.accent; }
                    Text { text: "Host:"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.text_secondary; width: 60px; }
                    Text { text: root.hostname; font-family: Typography.font_mono; font-size: Typography.size_xs; color: Theme.text_primary; overflow: elide; }
                }

                // Line 3: Kernel
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "❯"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.accent; }
                    Text { text: "Kernel:"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.text_secondary; width: 60px; }
                    Text { text: root.kernel_version; font-family: Typography.font_mono; font-size: Typography.size_xs; color: Theme.text_primary; overflow: elide; }
                }

                // Line 4: Uptime
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "❯"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.accent; }
                    Text { text: "Uptime:"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.text_secondary; width: 60px; }
                    Text { text: root.uptime_str; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_semibold; color: Theme.accent; }
                }

                // Line 5: Memory
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text { text: "❯"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.accent; }
                    Text { text: "Memory:"; font-family: Typography.font_mono; font-size: Typography.size_xs; font-weight: Typography.weight_bold; color: Theme.text_secondary; width: 60px; }
                    Text { text: root.ram_used_str + " / " + root.ram_total_str + " (" + root.ram_usage_str + "%)"; font-family: Typography.font_mono; font-size: Typography.size_xs; color: Theme.text_primary; }
                }
            }
        }
    }
}
