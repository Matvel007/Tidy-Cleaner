import { Theme } from "../theme/Palette.slint";
import { Typography } from "../theme/Typography.slint";

export component TopBar inherits Rectangle {
    in property <string> title: "Dashboard";
    in property <string> subtitle: "Real-time system diagnostics";

    height: 56px;
    background: Theme.surface;

    // Bottom border
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        alignment: start;

        // Title and Subtitle
        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-family: Typography.font_family;
                font-size: Typography.size_lg;
                font-weight: Typography.weight_bold;
                color: Theme.text_primary;
            }

            Text {
                text: root.subtitle;
                font-family: Typography.font_family;
                font-size: Typography.size_xs;
                color: Theme.text_muted;
            }
        }
    }
}
