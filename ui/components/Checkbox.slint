import { Theme } from "../theme/Palette.slint";
import { Typography } from "../theme/Typography.slint";
import { IconCheck } from "Icons.slint";

export component Checkbox inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> text: "";
    in property <bool> enabled: true;

    callback toggled(bool);

    height: 24px;
    background: Colors.transparent;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;

        box := Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius_sm;
            background: !root.enabled ? (Theme.is_dark ? #21242c : #f1f5f9) :
                root.checked ? Theme.accent : (touch.has-hover ? Theme.surface_hover : Theme.surface);
            border-width: 1.5px;
            border-color: root.checked ? Theme.accent : (touch.has-hover ? Theme.border_focus : Theme.border);

            animate background { duration: 120ms; easing: ease-out; }
            animate border-color { duration: 120ms; easing: ease-out; }

            if root.checked: IconCheck {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                icon_color: #ffffff;
                icon_size: 12px;
            }
        }

        if root.text != "": Text {
            text: root.text;
            font-family: Typography.font_family;
            font-size: Typography.size_base;
            color: !root.enabled ? Theme.text_muted : Theme.text_primary;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}
