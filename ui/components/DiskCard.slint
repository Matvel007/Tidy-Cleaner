import { Theme } from "../theme/Palette.slint";
import { Typography } from "../theme/Typography.slint";
import { I18n } from "../I18n.slint";
import { Card } from "Card.slint";
import { IconDisk } from "Icons.slint";

export component DiskCard inherits Card {
    in property <string> disk_name: I18n.dashboard_storage_primary;
    in property <string> file_system: "btrfs";
    in property <string> used_str: "0 GB";
    in property <string> total_str: "0 GB";
    in property <string> free_str: "0 GB";
    in property <float> usage_ratio: 0.0;
    in property <string> percent_str: "0%";

    padding_horizontal: 16px;
    padding_vertical: 14px;

    VerticalLayout {
        spacing: 10px;
        alignment: space-between;

        // Header
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;

                IconDisk {
                    y: (parent.height - self.height) / 2;
                    icon_size: 15px;
                }

                Text {
                    text: root.disk_name;
                    font-family: Typography.font_family;
                    font-size: Typography.size_sm;
                    font-weight: Typography.weight_semibold;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.percent_str;
                font-family: Typography.font_mono;
                font-size: Typography.size_sm;
                font-weight: Typography.weight_bold;
                color: Theme.text_primary;
                vertical-alignment: center;
            }
        }

        // Used / Total
        Text {
            text: root.used_str + " / " + root.total_str;
            font-family: Typography.font_family;
            font-size: Typography.size_base;
            font-weight: Typography.weight_semibold;
            color: Theme.text_primary;
        }

        // Progress Bar
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.surface_secondary;
            clip: true;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * Math.min(1.0, Math.max(0.0, root.usage_ratio));
                height: 100%;
                border-radius: 4px;
                background: root.usage_ratio > 0.9 ? Theme.danger :
                    root.usage_ratio > 0.75 ? Theme.warning : Theme.disk_chart;

                animate width { duration: 250ms; easing: ease-out; }
            }
        }

        // Details
        HorizontalLayout {
            alignment: space-between;

            Text {
                text: I18n.dashboard_storage_free + ": " + root.free_str;
                font-family: Typography.font_family;
                font-size: Typography.size_xs;
                color: Theme.text_muted;
            }

            Text {
                text: root.file_system;
                font-family: Typography.font_mono;
                font-size: Typography.size_xs;
                color: Theme.text_secondary;
            }
        }
    }
}
