import { Theme } from "../theme/Palette.slint";
import { Typography } from "../theme/Typography.slint";
import { I18n } from "../I18n.slint";
import { IconCleanup, IconFolder, IconCheck } from "Icons.slint";

export component CleanupItemRow inherits Rectangle {
    in property <string> item_id: "";
    in property <string> name: "";
    in property <string> path_str: "";
    in property <string> size_str: "0 B";
    in property <string> risk_level_code: "safe";
    in property <string> risk_level_text: "Safe";
    in property <bool> is_selected: false;

    callback toggled(string);
    callback open_clicked(string);

    height: 52px;
    border-radius: Theme.radius_md;
    background: row_ta.has-hover ? Theme.surface_hover : Theme.surface;
    border-width: 1px;
    border-color: root.is_selected ? Theme.accent : Theme.border;

    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }

    row_ta := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.toggled(root.item_id);
            }
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: space-between;

        // Left Section: Checkbox + Icon + Details
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            // Custom Checkbox
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 4px;
                background: root.is_selected ? Theme.accent : Theme.surface_secondary;
                border-width: 1px;
                border-color: root.is_selected ? Theme.accent : Theme.border;

                animate background { duration: 120ms; easing: ease-out; }

                if root.is_selected: IconCheck {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon_size: 11px;
                    icon_color: #ffffff;
                }
            }

            // Category Icon
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 32px;
                height: 32px;
                border-radius: Theme.radius_md;
                background: Theme.surface_secondary;

                IconCleanup {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon_size: 16px;
                    icon_color: Theme.text_primary;
                }
            }

            // Title & Monospace Path
            VerticalLayout {
                alignment: center;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.name;
                        font-family: Typography.font_family;
                        font-size: Typography.size_xs;
                        font-weight: Typography.weight_bold;
                        color: Theme.text_primary;
                    }

                    // Risk Badge
                    Rectangle {
                        height: 16px;
                        border-radius: 3px;
                        background: root.risk_level_code == "safe" ? #064e3b :
                            root.risk_level_code == "warning" ? #78350f : #7f1d1d;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: root.risk_level_text;
                                font-family: Typography.font_mono;
                                font-size: 9px;
                                font-weight: Typography.weight_bold;
                                color: root.risk_level_code == "safe" ? #34d399 :
                                    root.risk_level_code == "warning" ? #fbbf24 : #f87171;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: root.path_str;
                    font-family: Typography.font_mono;
                    font-size: 10px;
                    color: Theme.text_muted;
                    overflow: elide;
                    max-width: 440px;
                }
            }
        }

        // Right Section: Size + Tooltip Badge + Open Button
        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            Text {
                text: root.size_str;
                font-family: Typography.font_mono;
                font-size: Typography.size_xs;
                font-weight: Typography.weight_bold;
                color: Theme.text_primary;
                vertical-alignment: center;
            }

            // Live Tooltip Badge (inline, unclipped)
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 22px;
                border-radius: Theme.radius_sm;
                background: #18181b;
                border-width: 1px;
                border-color: #3f3f46;
                opacity: open_ta.has-hover ? 1.0 : 0.0;
                visible: self.opacity > 0.0;

                animate opacity { duration: 120ms; easing: ease-out; }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;

                    Text {
                        text: I18n.tooltip_open_folder;
                        font-family: Typography.font_family;
                        font-size: 10px;
                        font-weight: Typography.weight_medium;
                        color: #f4f4f5;
                        vertical-alignment: center;
                    }
                }
            }

            // Open Folder Button
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 28px;
                height: 28px;
                border-radius: Theme.radius_md;
                background: open_ta.has-hover ? Theme.surface_secondary : Colors.transparent;

                animate background { duration: 120ms; easing: ease-out; }

                IconFolder {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon_size: 14px;
                    icon_color: Theme.text_secondary;
                }

                open_ta := TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down {
                            root.open_clicked(root.item_id);
                        }
                    }
                }
            }
        }
    }
}
