import { Theme } from "../theme/Palette.slint";

export component MetricChart inherits Rectangle {
    in property <[float]> values: [0.0];
    in property <color> chart_color: Theme.cpu_chart;
    in property <length> custom_height: 54px;

    height: custom_height;
    background: Theme.surface_secondary;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: Theme.border_subtle;
    clip: true;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 3px;
        alignment: space-between;

        for val in root.values: Rectangle {
            horizontal-stretch: 1;
            height: 100%;
            background: Colors.transparent;

            // Bar background track
            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: 2px;
                background: Theme.surface_hover;
            }

            // Animated filled bar
            Rectangle {
                y: parent.height - self.height;
                width: 100%;
                height: Math.max(3px, parent.height * Math.min(1.0, Math.max(0.0, val / 100.0)));
                border-radius: 2px;
                background: val > 90.0 ? Theme.danger :
                    val > 75.0 ? Theme.warning : root.chart_color;

                animate height { duration: 250ms; easing: ease-out; }
                animate background { duration: 250ms; easing: ease-out; }
            }
        }
    }
}
