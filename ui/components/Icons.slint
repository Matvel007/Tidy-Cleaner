import { Theme } from "../theme/Palette.slint";

export component IconDashboard inherits Rectangle {
    in property <color> icon_color: Theme.text_primary;
    in property <length> icon_size: 18px;
    width: icon_size;
    height: icon_size;

    GridLayout {
        spacing: 2.5px;
        padding: 1px;
        Row {
            Rectangle {
                border-radius: 2px;
                background: icon_color;
            }
            Rectangle {
                border-radius: 2px;
                background: icon_color;
            }
        }
        Row {
            Rectangle {
                border-radius: 2px;
                background: icon_color;
            }
            Rectangle {
                border-radius: 2px;
                background: icon_color;
            }
        }
    }
}

export component IconCleanup inherits Rectangle {
    in property <color> icon_color: Theme.text_primary;
    in property <length> icon_size: 18px;
    width: icon_size;
    height: icon_size;

    Path {
        width: 100%;
        height: 100%;
        stroke: icon_color;
        stroke-width: 1.5px;
        commands: "M 4 5 L 14 5 M 6 5 L 6 15 A 1 1 0 0 0 7 16 L 11 16 A 1 1 0 0 0 12 15 L 12 5 M 8 5 L 8 3 A 1 1 0 0 1 9 2 L 9 2 A 1 1 0 0 1 10 3 L 10 5";
    }
}

