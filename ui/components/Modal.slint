import { Theme } from "../theme/Palette.slint";
import { Typography } from "../theme/Typography.slint";
import { Button } from "Button.slint";
import { IconButton } from "IconButton.slint";
import { IconClose } from "Icons.slint";
import { I18n } from "../I18n.slint";

export component Modal inherits Rectangle {
    in property <bool> is_open: false;
    in property <string> title: "Dialog";
    in property <string> confirm_text: I18n.common_save;
    in property <string> cancel_text: I18n.common_cancel;
    in property <bool> danger_action: false;

    callback confirmed();
    callback cancelled();

    width: 100%;
    height: 100%;
    visible: root.is_open;
    z: 1000;

    // Shake animation state
    property <int> shake_step: 0;
    property <length> shake_offset: shake_step == 1 ? 8px :
                                   shake_step == 2 ? -8px :
                                   shake_step == 3 ? 5px :
                                   shake_step == 4 ? -5px :
                                   shake_step == 5 ? 2px :
                                   shake_step == 6 ? -2px : 0px;

    animate shake_offset { duration: 40ms; easing: ease-in-out; }

    shake_timer := Timer {
        interval: 45ms;
        running: root.shake_step > 0;
        triggered => {
            if root.shake_step >= 6 {
                root.shake_step = 0;
            } else {
                root.shake_step += 1;
            }
        }
    }

    function trigger_shake() {
        root.shake_step = 1;
    }

    // Semi-transparent Dim Backdrop
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;

        backdrop_ta := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    root.trigger_shake();
                }
            }
        }
    }

    // Modal Card (isolated from backdrop clicks and animated with shake_offset)
    dialog_card := Rectangle {
        width: 360px;
        height: modal_layout.preferred-height;
        x: (parent.width - self.width) / 2 + root.shake_offset;
        y: (parent.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius_lg;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        // Card event trap: absorbs clicks inside dialog card
        TouchArea {}

        modal_layout := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            // Header
            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: root.title;
                    font-family: Typography.font_family;
                    font-size: Typography.size_base;
                    font-weight: Typography.weight_bold;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }

                IconButton {
                    size: 26px;
                    clicked => { root.cancelled(); }
                    IconClose {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon_size: 13px;
                    }
                }
            }

            // Body content slot
            @children

            // Footer Actions
            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Button {
                    text: root.cancel_text;
                    variant: "secondary";
                    custom_height: 32px;
                    clicked => { root.cancelled(); }
                }

                Button {
                    text: root.confirm_text;
                    variant: root.danger_action ? "danger" : "primary";
                    custom_height: 32px;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
