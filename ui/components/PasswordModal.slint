import { Theme } from "../theme/Palette.slint";
import { Typography } from "../theme/Typography.slint";
import { I18n } from "../I18n.slint";
import { Modal } from "Modal.slint";

export component PasswordModal inherits Modal {
    in property <string> prompt_text: I18n.auth_prompt_default;
    in-out property <string> password_input: "";
    in property <string> error_text: "";
    in property <bool> has_error: false;

    callback submitted(string);

    title: I18n.auth_modal_title;
    confirm_text: I18n.auth_modal_confirm;
    cancel_text: I18n.common_cancel;
    danger_action: true;

    forward-focus: pwd_le;

    changed has_error => {
        if root.has_error {
            root.trigger_shake();
        }
    }

    confirmed => {
        root.submitted(root.password_input);
    }

    VerticalLayout {
        spacing: 12px;
        vertical-stretch: 0;

        Text {
            text: root.prompt_text;
            font-family: Typography.font_family;
            font-size: Typography.size_xs;
            color: Theme.text_secondary;
            wrap: word-wrap;
        }

        // Password Input Field
        Rectangle {
            height: 34px;
            border-radius: Theme.radius_md;
            background: Theme.surface_secondary;
            border-width: 1px;
            border-color: root.has_error ? Theme.danger : (pwd_le.has-focus ? Theme.accent : Theme.border);

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;

                pwd_le := TextInput {
                    text <=> root.password_input;
                    input-type: password;
                    font-family: Typography.font_mono;
                    font-size: Typography.size_xs;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                    accepted => {
                        root.submitted(root.password_input);
                    }
                }
            }
        }

        // Error message if authentication failed
        if root.has_error: Text {
            text: root.error_text != "" ? root.error_text : I18n.auth_error_incorrect;
            font-family: Typography.font_family;
            font-size: 11px;
            font-weight: Typography.weight_medium;
            color: Theme.danger;
            wrap: word-wrap;
        }
    }
}
