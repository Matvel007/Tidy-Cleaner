import { Theme } from "../theme/Palette.slint";
import { Typography } from "../theme/Typography.slint";
import { I18n } from "../I18n.slint";
import { IconDashboard, IconCleanup, IconApplications, IconStartup, IconSettings, IconMenu } from "Icons.slint";

component NavItem inherits Rectangle {
    in property <string> title: "Item";
    in property <int> index: 0;
    in property <int> active_index: 0;
    in property <bool> expanded: true;
    
    callback selected(int);

    height: 42px;
    border-radius: Theme.radius_md;
    clip: true;

    property <bool> is_active: index == active_index;

    background: is_active ? Theme.surface_secondary :
        touch.has-hover ? Theme.surface_hover : Colors.transparent;

    border-width: is_active ? 1px : 0px;
    border-color: is_active ? Theme.border : Colors.transparent;

    animate background { duration: 150ms; easing: ease-out; }
    animate border-color { duration: 150ms; easing: ease-out; }

    // Active indicator
    if is_active: Rectangle {
        x: 0px;
        y: 8px;
        width: 3px;
        height: 26px;
        border-radius: 2px;
        background: Theme.accent;
    }

    // Icon Container: Always at fixed 13px, perfectly centered when collapsed (44px item)
    Rectangle {
        x: 13px;
        y: (parent.height - 18px) / 2;
        width: 18px;
        height: 18px;

        if root.index == 0: IconDashboard {
            width: 100%;
            height: 100%;
            icon_color: is_active ? Theme.text_primary : (touch.has-hover ? Theme.text_primary : Theme.text_secondary);
        }
        if root.index == 1: IconCleanup {
            width: 100%;
            height: 100%;
            icon_color: is_active ? Theme.text_primary : (touch.has-hover ? Theme.text_primary : Theme.text_secondary);
        }
        if root.index == 2: IconApplications {
            width: 100%;
            height: 100%;
            icon_color: is_active ? Theme.text_primary : (touch.has-hover ? Theme.text_primary : Theme.text_secondary);
        }
        if root.index == 3: IconStartup {
            width: 100%;
            height: 100%;
            icon_color: is_active ? Theme.text_primary : (touch.has-hover ? Theme.text_primary : Theme.text_secondary);
        }
        if root.index == 4: IconSettings {
            width: 100%;
            height: 100%;
            icon_color: is_active ? Theme.text_primary : (touch.has-hover ? Theme.text_primary : Theme.text_secondary);
        }
    }

    // Label Text: Smoothly fades in/out with no DOM recreation jump
    Text {
        x: 44px;
        y: 0px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.title;
        font-family: Typography.font_family;
        font-size: Typography.size_base;
        font-weight: is_active ? Typography.weight_semibold : Typography.weight_normal;
        color: is_active ? Theme.text_primary : (touch.has-hover ? Theme.text_primary : Theme.text_secondary);
        vertical-alignment: center;
        overflow: elide;
        opacity: root.expanded ? 1.0 : 0.0;

        animate opacity { duration: 140ms; easing: ease-out; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.selected(root.index);
        }
    }
}

export component Sidebar inherits Rectangle {
    in-out property <int> active_page: 0;
    in-out property <bool> is_expanded: false;
    
    callback page_changed(int);
    callback toggle_expand();

    width: is_expanded ? 175px : 64px;
    background: Theme.surface;
    border-width: 0px;
    clip: true;

    animate width { duration: 200ms; easing: ease-out; }

    // Right border line
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        // Header with expand/collapse button
        Rectangle {
            height: 38px;

            // Menu Toggle button: perfectly centered in 44px width
            toggle_btn := Rectangle {
                x: 5px;
                y: (parent.height - self.height) / 2;
                width: 34px;
                height: 34px;
                border-radius: Theme.radius_md;
                background: toggle_touch.has-hover ? Theme.surface_hover : Colors.transparent;

                animate background { duration: 120ms; easing: ease-out; }

                IconMenu {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon_size: 18px;
                    icon_color: Theme.text_secondary;
                }

                toggle_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.is_expanded = !root.is_expanded;
                        root.toggle_expand();
                    }
                }
            }
        }

        // Nav items
        NavItem {
            title: I18n.nav_dashboard;
            index: 0;
            active_index: root.active_page;
            expanded: root.is_expanded;
            selected(idx) => {
                root.active_page = idx;
                root.page_changed(idx);
            }
        }

        NavItem {
            title: I18n.nav_cleanup;
            index: 1;
            active_index: root.active_page;
            expanded: root.is_expanded;
            selected(idx) => {
                root.active_page = idx;
                root.page_changed(idx);
            }
        }

        NavItem {
            title: I18n.nav_applications;
            index: 2;
            active_index: root.active_page;
            expanded: root.is_expanded;
            selected(idx) => {
                root.active_page = idx;
                root.page_changed(idx);
            }
        }

        NavItem {
            title: I18n.nav_startup;
            index: 3;
            active_index: root.active_page;
            expanded: root.is_expanded;
            selected(idx) => {
                root.active_page = idx;
                root.page_changed(idx);
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        NavItem {
            title: I18n.nav_settings;
            index: 4;
            active_index: root.active_page;
            expanded: root.is_expanded;
            selected(idx) => {
                root.active_page = idx;
                root.page_changed(idx);
            }
        }
    }
}
