import { Theme } from "../theme/Palette.slint";
import { Typography } from "../theme/Typography.slint";

export component SearchInput inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder_text: "Search...";
    in property <bool> enabled: true;

    callback edited(string);
    callback accepted(string);

    height: 36px;
    border-radius: Theme.radius_md;
    background: Theme.is_dark ? Theme.surface_secondary : #ffffff;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    animate border-color { duration: 150ms; easing: ease-out; }

    input := TextInput {
        x: 14px;
        y: 0px;
        width: parent.width - 28px;
        height: 100%;
        text <=> root.text;
        enabled: root.enabled;
        font-family: Typography.font_family;
        font-size: Typography.size_xs;
        color: Theme.text_primary;
        horizontal-alignment: left;
        vertical-alignment: center;
        single-line: true;

        edited => {
            root.edited(self.text);
        }

        accepted => {
            root.accepted(self.text);
        }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 14px;
        y: 0px;
        width: parent.width - 28px;
        height: 100%;
        text: root.placeholder_text;
        font-family: Typography.font_family;
        font-size: Typography.size_xs;
        color: Theme.text_muted;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
}
